NODE_ENV=development

# Database
DATABASE_URL="mongodb://localhost:27017/cybersim?replicaSet=rs0"
REDIS_URL="redis://localhost:6380"

# Auth
JWT_SECRET="change-me-to-a-random-32-plus-character-secret"
JWT_EXPIRES_IN="7d"

# Docker
DOCKER_HOST="unix:///var/run/docker.sock"
SANDBOX_IMAGE="cybersim-sandbox:latest"
SANDBOX_CPU_LIMIT="0.5"
SANDBOX_MEMORY_LIMIT="256m"

# Network Engine
NETWORK_ENGINE_URL="http://localhost:8000"
NETWORK_ENGINE_SECRET="internal-secret-key"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_WS_URL="ws://localhost:3001"
