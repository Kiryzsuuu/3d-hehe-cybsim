NODE_ENV=development

# Database: MongoDB Atlas connection string (get yours from the Atlas dashboard)
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster-host>/cybersim?retryWrites=true&w=majority&appName=<app-name>"
REDIS_URL="redis://localhost:6380"

# Auth
JWT_SECRET="change-me-to-a-random-32-plus-character-secret"
JWT_EXPIRES_IN="7d"

# Docker
DOCKER_HOST="unix:///var/run/docker.sock"
SANDBOX_IMAGE="cybersim-sandbox:latest"
SANDBOX_CPU_LIMIT="0.5"
SANDBOX_MEMORY_LIMIT="256m"

# DVWA (Damn Vulnerable Web App) sandbox
DVWA_IMAGE="vulnerables/web-dvwa"
DVWA_CPU_LIMIT="0.5"
DVWA_MEMORY_LIMIT_MB="512"

# Network Engine
NETWORK_ENGINE_URL="http://localhost:8000"
NETWORK_ENGINE_SECRET="internal-secret-key"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_WS_URL="ws://localhost:3001"

# Admin seed (only used by `pnpm db:seed-admin`, never read at runtime)
ADMIN_EMAIL="admin@example.com"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-min-6-chars"
