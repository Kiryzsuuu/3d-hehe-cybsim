{
  "name": "cyber-simulator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "pnpm --filter ./packages/* build",
    "dev": "pnpm --parallel --filter ./apps/* dev",
    "build": "pnpm --filter ./packages/* build && pnpm --filter ./apps/* build",
    "lint": "pnpm --filter ./apps/* lint"
  },
  "engines": {
    "node": ">=20"
  }
}
